generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String      @id @default(uuid())
  email     String   @unique
  username  String
  passwordHash String
  refreshTokenHash String?
  createdAt DateTime @default(now())
}

model BlacklistedAccessToken {
  id        String   @id @default(uuid())
  jti       String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
}
