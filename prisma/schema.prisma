generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                  String                  @id @default(uuid())
  email               String                  @unique
  username            String
  isAdmin             Boolean                 @default(false)
  passwordHash        String
  refreshTokenHash String?
  createdAt           DateTime                @default(now())
  playerProfiles      PlayerProfile[]
  blacklistedTokens   BlacklistedAccessToken[]
}

model BlacklistedAccessToken {
  id        String   @id @default(uuid())
  jti       String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Game {
  id              String           @id @default(uuid())
  key             String           @unique
  name            String
  metadata        Json?
  isActive        Boolean          @default(true)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  playerProfiles  PlayerProfile[]
  itemDefinitions ItemDefinition[]
  currencyDefinitions CurrencyDefinition[]
  scheduledRewardDefinitions ScheduledRewardDefinition[]
}

model PlayerProfile {
  id               String           @id @default(uuid())
  userId           String
  gameId           String
  displayName      String?
  metadata         Json?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  game             Game             @relation(fields: [gameId], references: [id], onDelete: Cascade)
  inventoryEntries InventoryEntry[]
  currencyBalances CurrencyBalance[]
  scheduledRewardProgress ScheduledRewardProgress[]
  scheduledRewardClaims ScheduledRewardClaim[]

  @@unique([userId, gameId])
}

model ItemDefinition {
  id               String           @id @default(uuid())
  gameId           String
  code             String
  name             String
  type             String
  stackable        Boolean          @default(true)
  metadata         Json?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  game             Game             @relation(fields: [gameId], references: [id], onDelete: Cascade)
  inventoryEntries InventoryEntry[]
  scheduledRewardDefinitions ScheduledRewardDefinition[]

  @@unique([gameId, code])
}

model InventoryEntry {
  id               String         @id @default(uuid())
  playerProfileId  String
  itemDefinitionId String
  quantity         Int            @default(0)
  instanceData     Json?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  playerProfile    PlayerProfile  @relation(fields: [playerProfileId], references: [id], onDelete: Cascade)
  itemDefinition   ItemDefinition @relation(fields: [itemDefinitionId], references: [id], onDelete: Cascade)

  @@unique([playerProfileId, itemDefinitionId])
}

model CurrencyDefinition {
  id               String            @id @default(uuid())
  gameId           String
  code             String
  name             String
  metadata         Json?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  game             Game              @relation(fields: [gameId], references: [id], onDelete: Cascade)
  currencyBalances CurrencyBalance[]
  scheduledRewardDefinitions ScheduledRewardDefinition[]

  @@unique([gameId, code])
}

model CurrencyBalance {
  id                 String             @id @default(uuid())
  playerProfileId    String
  currencyDefinitionId String
  balance            Int                @default(0)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  playerProfile      PlayerProfile      @relation(fields: [playerProfileId], references: [id], onDelete: Cascade)
  currencyDefinition CurrencyDefinition @relation(fields: [currencyDefinitionId], references: [id], onDelete: Cascade)

  @@unique([playerProfileId, currencyDefinitionId])
}

enum ScheduledRewardType {
  CURRENCY
  ITEM
}

enum RewardScheduleType {
  DAILY
  WEEKLY
  YEARLY
}

model ScheduledRewardDefinition {
  id                   String              @id @default(uuid())
  gameId               String
  scheduleType         RewardScheduleType
  sequence             Int
  rewardType           ScheduledRewardType
  amount               Int
  currencyDefinitionId String?
  itemDefinitionId     String?
  metadata             Json?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  game                 Game                @relation(fields: [gameId], references: [id], onDelete: Cascade)
  currencyDefinition   CurrencyDefinition? @relation(fields: [currencyDefinitionId], references: [id], onDelete: Restrict)
  itemDefinition       ItemDefinition?     @relation(fields: [itemDefinitionId], references: [id], onDelete: Restrict)
  claims               ScheduledRewardClaim[]

  @@unique([gameId, scheduleType, sequence])
}

model ScheduledRewardProgress {
  id                     String             @id @default(uuid())
  playerProfileId        String
  scheduleType           RewardScheduleType
  currentStreak          Int                @default(0)
  totalClaims            Int                @default(0)
  lastClaimedAt          DateTime?
  lastClaimedPeriodStart DateTime?
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt
  playerProfile          PlayerProfile      @relation(fields: [playerProfileId], references: [id], onDelete: Cascade)

  @@unique([playerProfileId, scheduleType])
}

model ScheduledRewardClaim {
  id                        String                    @id @default(uuid())
  playerProfileId           String
  scheduledRewardDefinitionId String
  scheduleType              RewardScheduleType
  claimedPeriodStart        DateTime
  streakStep                Int
  claimedAt                 DateTime                  @default(now())
  createdAt                 DateTime                  @default(now())
  playerProfile             PlayerProfile             @relation(fields: [playerProfileId], references: [id], onDelete: Cascade)
  scheduledRewardDefinition ScheduledRewardDefinition @relation(fields: [scheduledRewardDefinitionId], references: [id], onDelete: Cascade)

  @@unique([playerProfileId, scheduleType, claimedPeriodStart])
}
